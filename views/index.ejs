<!-- includes header, main_nav, and footer partials. -->
<!DOCTYPE html>
<html>
  <head>
  </head>
  <body>
    <%- include partials/header.ejs %>
    <%- include partials/main_nav.ejs %>
    <%- include partials/footer.ejs %>
    <div id="content">
    <h1>
      <%= title %>
    </h1>
    <p>Multiple Choice template</p>
    <form id="contactForm">
      <label for= "nameOfQuiz">Enter Name of Quiz:</label><br>
      <input type="text" id="nameOfQuiz" name="nameOfQuiz" required placeholder="Enter Name of Quiz" style="width: 55%;"><br>
      <input type="checkbox">
      <input type="text" id="checkbox1" name="checkbox1"><br>
      <input type="checkbox">
      <input type="text" id="checkbox2" name="checkbox2"><br>
      <input type="checkbox">
      <input type="text" id="checkbox3" name="checkbox3"><br>
      <input type="checkbox">
      <input type="text" id="checkbox4" name="checkbox4"><br>
      <br>
      <button type="submit" id="submit">Submit</button>
      <!--<input type="submit" value="Submit">-->
    </form>
    <br>
    <br>
    <button id = 'addCheckbox' type="addCheckbox">Add Checkbox</button>
    <button id = 'addInput' type="addInput">Add Input</button><br>
    </div>
</html>

<script>
  //Submit Taken from https://www.youtube.com/shorts/ho_30dN-GMM
  const form = document.getElementById('contactForm');
  //const submit = document.getElementById('submit');

  let uniqueId = 4

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(e.target);
    const entries = Object.fromEntries(data.entries());
    console.log(entries)
  });

  document.getElementById("addInput").addEventListener("click", () => {
    uniqueId++;

    const input = document.createElement("input");
    input.id = 'input';
    input.type = 'text';
    input.placeholder = 'No need to fill out'

    const question = document.createElement("input");
    question.id = 'question' + uniqueId;
    question.name = 'question' + uniqueId;
    question.type = 'text';
    question.placeholder = 'Put Question Here'

    const lineBreak = document.createElement('br');

    const contactForm = document.getElementById('contactForm');
    contactForm.appendChild(input);
    contactForm.appendChild(question);
    contactForm.insertBefore(question, submit);
    contactForm.insertBefore(input, submit);
    contactForm.insertBefore(lineBreak, submit);
  });

  document.getElementById("addCheckbox").addEventListener("click", () => {
    uniqueId++;

    const checkbox = document.createElement("input");
    checkbox.id = 'checkbox';
    checkbox.name = 'checkbox' + uniqueId;
    checkbox.type = "checkbox";
    

    const input = document.createElement("input");
    input.id = 'checkbox' + uniqueId;
    input.type = 'text';
    input.name = 'checkbox' + uniqueId

    const lineBreak = document.createElement('br');

    const contactForm = document.getElementById('contactForm');
    contactForm.appendChild(checkbox);
    contactForm.appendChild(input);
    contactForm.insertBefore(checkbox, submit);
    contactForm.insertBefore(input, submit);
    contactForm.insertBefore(lineBreak, submit);
  });

</script>