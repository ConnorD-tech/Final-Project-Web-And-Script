<!DOCTYPE html>
<html>
  <head>
  </head>
  <body>
    <%- include partials/header.ejs %>
    <%- include partials/main_nav.ejs %>
    <%- include partials/footer.ejs %>
    <h1>
      <%= title %>
    </h1>
    <p>Welcome to <%= title %>
    </p>
    <form id="contactForm">
      <label for= "nameOfQuiz">Name:</label><br>
      <input type="text" id="nameOfQuiz" name="nameOfQuiz" required><br>
      <button type="submit" id="submit">Submit</button>
      <!--<input type="submit" value="Submit">-->
    </form>
    <input type="text" id="text" name="text"><br>
    <button id = 'addCheckbox' type="addCheckbox">Add Checkbox</button><br>
    <button id = 'addInput' type="addInput">Add Input</button><br>
  </body>
</html>


<script>
  //Submit Taken from https://www.youtube.com/shorts/ho_30dN-GMM
  const form = document.getElementById('contactForm');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(e.target);
    //const nameOfQuiz = data.get('nameOfQuiz');
    //console.log(nameOfQuiz);
    const entries = Object.fromEntries(data.entries());
    console.table(entries);
  });

  //adds things to form
  document.getElementById("addInput").addEventListener("click", () => {
    const idk = document.getElementById("text");
    const text = idk.value;

    const input = document.createElement("input");
    input.id = 'input';
    input.name = 'input';
    input.type = 'text';

    const label = document.createElement('label');
    label.htmlFor = 'input'; 
    label.textContent = text;

    const lineBreak = document.createElement('br');

    const contactForm = document.getElementById('contactForm');
    contactForm.appendChild(input);
    contactForm.appendChild(label);
    contactForm.insertBefore(label, submit);
    contactForm.insertBefore(input, submit);
    contactForm.insertBefore(lineBreak, submit);
  });

  document.getElementById("addCheckbox").addEventListener("click", () => {
    const idk = document.getElementById("text");
    const text = idk.value;

    const checkbox = document.createElement("input");
    checkbox.id = 'checkbox';
    checkbox.name = 'checkbox';
    checkbox.type = "checkbox";

    const label = document.createElement('label');
    label.htmlFor = 'checkbox'; // Must match the checkbox's id
    label.textContent = text;

    const lineBreak = document.createElement('br');

    const contactForm = document.getElementById('contactForm');
    contactForm.appendChild(checkbox);
    contactForm.appendChild(label);
    contactForm.insertBefore(label, submit);
    contactForm.insertBefore(checkbox, submit);
    contactForm.insertBefore(lineBreak, submit);
  });
</script>